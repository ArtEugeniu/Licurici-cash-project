# Telegram backup (opțional)
# 1. Creați bot la @BotFather -> /newbot -> copiați tokenul
# 2. Deschideți botul și apăsați Start
# 3. Rulați: npm run backup:chat-id
# 4. Copiați chat_id aici

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Opțional: dacă este setat, botul răspunde doar acestui chat.
# Dacă lipsește, se folosește TELEGRAM_CHAT_ID ca listă permisă.
TELEGRAM_ALLOWED_CHAT_ID=

# Backup automat (implicit: doar la oprirea serverului)
BACKUP_ON_START=false
BACKUP_ON_SHUTDOWN=true
BACKUP_INTERVAL_HOURS=24
BACKUP_LOCAL_KEEP=7
